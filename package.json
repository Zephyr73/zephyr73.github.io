{
  "name": "zephyr73.github.io",
  "version": "3.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "npx @11ty/eleventy",
    "build:css": "sass src/v2/scss/style.scss:src/assets/css/style.css src/v3/scss/desktop.scss:src/assets/css/desktop.css --no-source-map",
    "watch:css": "sass --watch src/v2/scss/style.scss:src/assets/css/style.css src/v3/scss/desktop.scss:src/assets/css/desktop.css",
    "dev": "concurrently \"npm:start\" \"npm:watch:css\"",
    "format": "prettier --write \"**/*.{html,js,css,scss,md}\"",
    "lint:js": "eslint \"**/*.js\"",
    "lint": "npm run lint:js",
    "start": "npx @11ty/eleventy --serve"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "exif-reader": "^2.0.3",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3"
  }
}
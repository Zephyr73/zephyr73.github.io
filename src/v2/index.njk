{% from "components/button.njk" import button %}
{% from "components/card.njk" import project_card %}
<!-- ── HERO SECTION ──────────────────────────────────────────────────────── -->
<section class="home-hero pt-6 pb-[3.5rem] border-b border-border mb-[3.5rem] max-md:pt-2 max-md:pb-[2.5rem] max-md:mb-[2.5rem]">
  <h1 class="hero-title font-heading text-[clamp(2rem,5vw,3.6rem)] font-extrabold leading-[1.1] tracking-[-0.035em]
      text-body-text m-0 mb-5 max-w-[840px] max-md:text-[clamp(1.85rem,7vw,2.75rem)] max-md:leading-[1.15]">
    Backend systems, homelab infrastructure, and automated tooling.
  </h1>
  <p class="hero-subtitle font-regular text-[0.98rem] leading-[1.75] text-text-muted max-w-[740px] m-0 mb-7
      max-md:text-[0.925rem] max-md:leading-[1.65]">
    Hi, I'm
    <strong class="text-accent font-bold">Tasrif</strong>
    — a Computer Science student at Queens College. I build Linux systems, DevOps pipelines, and self-hosted
    infrastructure — currently operating 5 Debian LXC containers in my Proxmox homelab with zero-trust networking.
  </p>
  <!-- Core Stack / Technical Badges -->
  <div class="hero-stack mb-8">
    <div class="flex flex-wrap items-center gap-2">
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">Bash</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">Caddy</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">CI/CD</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">Docker</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">Git</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">Linux / Debian</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">LXC</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">Networking &amp; DNS</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">PowerShell</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">Proxmox VE</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">Python</span>
      <span class="font-regular text-[0.72rem] py-1 px-2.5 bg-surface border border-border text-text-muted">WireGuard</span>
    </div>
  </div>
  <!-- Infrastructure & System Metrics -->
  <div class="hero-metrics grid grid-cols-3 gap-3 mb-8 max-[720px]:grid-cols-1">
    <div class="p-3.5 bg-surface border border-border flex flex-col gap-1">
      <div class="flex items-center justify-between">
        <span class="font-regular text-[0.68rem] uppercase tracking-[0.06em] text-text-muted">Virtualization Cluster</span>
      </div>
      <span class="font-heading font-bold text-[1.1rem] text-body-text">5 LXC Nodes</span>
      <span class="font-regular text-[0.72rem] text-text-subtle">Debian on Proxmox VE</span>
    </div>
    <div class="p-3.5 bg-surface border border-border flex flex-col gap-1">
      <div class="flex items-center justify-between">
        <span class="font-regular text-[0.68rem] uppercase tracking-[0.06em] text-text-muted">Edge DNS Redundancy</span>
      </div>
      <span class="font-heading font-bold text-[1.1rem] text-body-text">~340ms Failover</span>
      <span class="font-regular text-[0.72rem] text-text-subtle">Dual-node Pi + LXC AdGuard</span>
    </div>
    <div class="p-3.5 bg-surface border border-border flex flex-col gap-1">
      <div class="flex items-center justify-between">
        <span class="font-regular text-[0.68rem] uppercase tracking-[0.06em] text-text-muted">Remote Access Security</span>
      </div>
      <span class="font-heading font-bold text-[1.1rem] text-body-text">0 Exposed Ports</span>
      <span class="font-regular text-[0.72rem] text-text-subtle">Mesh VPN via WireGuard</span>
    </div>
  </div>
  <div class="hero-actions flex items-center flex-wrap gap-[0.85rem] max-[480px]:flex-col max-[480px]:items-stretch
      max-[480px]:gap-[0.65rem]">
    {{ button("View Resume", "/about/", "primary", "_self", true) }}
    {{ button("Explore Projects", "/projects/", "secondary") }}
    {{ button("Visual Gallery ↗", "/gallery/", "ghost") }}
  </div>
</section>
<!-- ── FEATURED PROJECTS ─────────────────────────────────────────────────── -->
<section class="home-section mb-16 max-md:mb-12">
  <div class="section-header flex justify-between items-end mb-7 flex-wrap gap-3 max-md:mb-5">
    <div class="section-header__title-group">
      <h2 class="section-title font-heading text-[clamp(1.35rem,3vw,1.85rem)] font-bold tracking-[-0.03em] text-body-text m-0">
        Featured Projects
      </h2>
    </div>
    <a
      href="/projects/"
      class="section-link font-regular text-[0.825rem] text-text-muted no-underline transition-colors duration-150 ease-default
        hover:text-accent">
    View All Projects →</a>
  </div>
  <div class="projects-grid grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-6 max-[640px]:grid-cols-1
      max-[640px]:gap-5">
    {% for project in collections.project %}
      {% if project.fileSlug == 'home-network' or project.fileSlug == 'wallpapersync' %}
        {{ project_card(project) }}
      {% endif %}
    {% endfor %}
  </div>
</section>
<!-- ── CREATIVE SHOWCASE ─────────────────────────────────────────────────── -->
<section class="home-section mb-16 max-md:mb-12">
  <div class="section-header flex justify-between items-end mb-7 flex-wrap gap-3 max-md:mb-5">
    <div class="section-header__title-group">
      <h2 class="section-title font-heading text-[clamp(1.35rem,3vw,1.85rem)] font-bold tracking-[-0.03em] text-body-text m-0">
        Photography &amp; Generative Art
      </h2>
    </div>
    <a
      href="/gallery/"
      class="section-link font-regular text-[0.825rem] text-text-muted no-underline transition-colors duration-150 ease-default
        hover:text-accent">
    Open Full Gallery →</a>
  </div>
  <div
    class="creative-grid grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-6 max-[640px]:grid-cols-1 max-[640px]:gap-5">
    <!-- Creative Card 1: Photography -->
    <a
      href="/gallery/"
      class="creative-card group/creative bg-surface border border-border no-underline flex flex-col overflow-hidden
        transition-[border-color,transform,box-shadow] duration-200 ease-default hover:border-accent hover:-translate-y-[2px]
        hover:shadow-[0_4px_20px_var(--color-accent-glow)]">
      <div class="creative-card__image-wrap relative w-full aspect-video overflow-hidden bg-[#050505] [&>picture]:block
          [&>picture]:w-full [&>picture]:h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:block
          [&_img]:transition-transform [&_img]:duration-300 [&_img]:ease-default group-hover/creative:[&_img]:scale-[1.04]">
        <picture>
          <source srcset="/assets/img/photo.webp" type="image/webp"/>
          <img
            src="/assets/img/photo.jpg"
            alt="Urban and landscape photography"
            loading="lazy"
            decoding="async"
            width="600"
            height="338"/>
        </picture>
      </div>
      <div class="creative-card__info p-5 flex flex-col gap-2 grow max-[640px]:p-4">
        <h3 class="m-0 font-heading text-[1.2rem] text-body-text transition-colors group-hover/creative:text-accent">
          Photography
        </h3>
        <p class="m-0 font-regular text-[0.825rem] leading-[1.6] text-text-muted">
          Curated architectural, cityscape, and natural moments captured and graded with Adobe Lightroom.
        </p>
        <span class="creative-card__link inline-block mt-3 font-regular text-[0.8rem] font-semibold text-accent">Browse Photos →</span>
      </div>
    </a>
    <!-- Creative Card 2: AI Art -->
    <a
      href="/gallery/#ai-container"
      class="creative-card group/creative bg-surface border border-border no-underline flex flex-col overflow-hidden
        transition-[border-color,transform,box-shadow] duration-200 ease-default hover:border-accent hover:-translate-y-[2px]
        hover:shadow-[0_4px_20px_var(--color-accent-glow)]">
      <div class="creative-card__image-wrap relative w-full aspect-video overflow-hidden bg-[#050505] [&>picture]:block
          [&>picture]:w-full [&>picture]:h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:block
          [&_img]:transition-transform [&_img]:duration-300 [&_img]:ease-default group-hover/creative:[&_img]:scale-[1.04]">
        <picture>
          <source srcset="/assets/img/ai.webp" type="image/webp"/>
          <img
            src="/assets/img/ai.jpg"
            alt="Stable Diffusion generative artwork"
            loading="lazy"
            decoding="async"
            width="600"
            height="338"/>
        </picture>
      </div>
      <div class="creative-card__info p-5 flex flex-col gap-2 grow max-[640px]:p-4">
        <h3 class="m-0 font-heading text-[1.2rem] text-body-text transition-colors group-hover/creative:text-accent">
          AI Generations
        </h3>
        <p class="m-0 font-regular text-[0.825rem] leading-[1.6] text-text-muted">
          Explorations in latent space composition, pose control, and stylized diffusion artwork.
        </p>
        <span class="creative-card__link inline-block mt-3 font-regular text-[0.8rem] font-semibold text-accent">Explore AI
          Gallery →</span>
      </div>
    </a>
  </div>
</section>

---
layout: base.njk
permalink: /blog/
title: Blog | My Portfolio
bodyClass: page--blog
pageId: blog-index
---

<div class="blog-list">
    <!-- Loop through the collection named 'blogpost' in reverse chronological order -->
    {% for post in collections.blogpost | reverse %}
        <article class="blog-preview">
            <h2>
                <a href="{{ post.url }}">{{ post.data.title }}</a>
            </h2>
            <p class="blog-description">
                {{ post.data.description }}
            </p>
            <a href="{{ post.url }}" class="read-more">Read Article →</a>
        </article>
    {% endfor %}
</div>
---
layout: base.njk
noMarkdownWrapper: true
---
{% from "components/card.njk" import project_card %}

<div class="blog-page max-w-[900px] mx-auto">
  <div class="page-intro pb-6 mb-2 max-md:pb-4">
    <h1 class="page-intro__title font-heading text-[clamp(1.65rem,3.4vw,2.2rem)] font-bold tracking-[-0.02em] leading-[1.2] text-body-text m-0 mb-2.5">{{ heading | safe }}</h1>
    <p class="page-intro__desc font-regular text-[0.9rem] leading-[1.65] text-text-muted max-w-[680px] m-0">
      {{ intro | safe }}
    </p>
  </div>

  <div class="dither-rule mb-2" aria-hidden="true"></div>

  <div class="blog-list flex flex-col">
    {% for post in collections.blogpost | sortByDate %}
      {{ project_card(post, "Read post") }}
    {% endfor %}
  </div>
</div>

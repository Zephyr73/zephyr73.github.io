<!-- ── RESUME HEADER ─────────────────────────────────────────────────── -->
<header class="resume-header grid grid-cols-[200px_1fr] gap-10 items-start mb-10 pb-2 max-md:grid-cols-1 max-md:gap-7 max-md:mb-8 print:block print:border-b-[1.5pt] print:border-[#111111] print:pb-[5pt] print:mb-[7pt] print:text-center">
  <div class="resume-sidebar flex flex-col gap-5 print:hidden">
    <div class="avatar-frame relative w-full aspect-square border border-border bg-surface overflow-hidden max-md:max-w-[180px] max-md:mx-auto">
      <picture class="block w-full h-full">
        <source srcset="/assets/img/profile.webp" type="image/webp" />
        <img class="resume-avatar block w-full h-full object-cover" src="{{ profile.avatar | default('/assets/img/profile.png') }}" alt="{{ profile.name | default('Tasrif') }} avatar" width="400" height="400" loading="eager" decoding="async" />
      </picture>
    </div>

    <div class="resume-links flex flex-col gap-2 max-md:grid max-md:grid-cols-2 max-[440px]:grid-cols-1">
      {% if profile.email %}
      <button
        class="resume-btn resume-contact__copy flex items-center justify-start overflow-hidden group/copy gap-2 py-2 px-3 bg-surface border border-border text-body-text font-regular text-[0.8rem] no-underline cursor-pointer transition-all duration-150 ease-default rounded-none text-left min-h-[38px] box-border hover:border-accent hover:text-accent hover:bg-surface-2"
        data-copy="{{ profile.email }}"
        type="button"
        aria-label="Copy email {{ profile.email }}"
        title="Copy email: {{ profile.email }}"
      >
        <svg
          class="mail-icon shrink-0 text-accent"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" />
          <path d="M22 6L12 13L2 6" />
        </svg>
        <span class="btn-text text-[0.76rem] tracking-[-0.01em] whitespace-nowrap overflow-hidden text-ellipsis">{{ profile.email }}</span>
        <svg
          class="copy-icon ml-auto shrink-0 text-text-muted transition-colors duration-150 ease-default group-hover/copy:text-accent"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
      </button>
      {% endif %}

      {% for link in profile.socials %}
      <a
        href="{{ link.url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="resume-btn flex items-center gap-2 py-2 px-3 bg-surface border border-border text-body-text font-regular text-[0.8rem] no-underline cursor-pointer transition-all duration-150 ease-default rounded-none text-left min-h-[38px] box-border hover:border-accent hover:text-accent hover:bg-surface-2"
      >
        {% if link.icon == 'github' %}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
        >
          <path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
          />
        </svg>
        {% elif link.icon == 'twitter' %}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
        >
          <path
            d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"
          />
        </svg>
        {% elif link.icon == 'linkedin' %}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect x="2" y="9" width="4" height="12" />
          <circle cx="4" cy="4" r="2" />
        </svg>
        {% endif %}
        {{ link.label }}
      </a>
      {% endfor %}

      <a
        href="/assets/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="resume-btn resume-btn--pdf flex items-center gap-2 py-2 px-3 bg-surface border border-border text-accent font-regular text-[0.8rem] no-underline cursor-pointer transition-all duration-150 ease-default rounded-none text-left min-h-[38px] box-border hover:border-accent hover:bg-surface-2"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Download Resume
      </a>
    </div>
  </div>

  <div class="resume-intro flex flex-col print:text-center">
    <div class="resume-headline print:text-center">
      <h1 class="resume-name font-heading text-[clamp(1.75rem,3.6vw,2.4rem)] font-bold tracking-[-0.02em] leading-[1.15] m-0 mb-3 text-body-text print:text-[18pt] print:font-extrabold print:tracking-[-0.02em] print:m-0 print:mb-[3pt] print:text-[#000000] print:text-center print:leading-[1.1]">{{ profile.name | default('Tasrif') }}</h1>
      <div class="resume-role-tag inline-block font-code text-[0.75rem] font-semibold tracking-[0.04em] uppercase text-accent bg-surface border border-border py-1 px-[10px] mb-5 w-fit print:hidden">{{ profile.role | default('IT & DevOps Specialist • Computer Science') | safe }}</div>
      <div class="resume-contact-print hidden print:block print:text-[8.5pt] print:text-[#333333] print:text-center print:m-0 print:p-0 [&>span>a]:text-[#111111] [&>span>a]:underline">
        <span>{{ profile.location | default('New York, NY') }}</span> •
        <span><a href="mailto:{{ profile.email }}">{{ profile.email }}</a></span> •
        {% for link in profile.socials %}
          {% if link.icon == 'github' %}
          <span><a href="{{ link.url }}">{{ link.url | replace('https://', '') }}</a></span> •
          {% elif link.icon == 'linkedin' %}
          <span><a href="{{ link.url }}">{{ link.url | replace('https://www.', '') | replace('https://', '') }}</a></span> •
          {% endif %}
        {% endfor %}
        <span><a href="https://tasrif.dev">tasrif.dev</a></span>
      </div>
    </div>

    {% if profile.summary %}
    <p class="resume-summary-print hidden print:block print:text-[8.5pt] print:leading-[1.32] print:text-[#222222] print:text-left print:m-0 print:mt-[5pt] print:p-0">
      {{ profile.summary | safe }}
    </p>
    {% endif %}

    {% if profile.bio %}
    <div class="resume-bio print:hidden [&>p]:font-regular [&>p]:text-[0.95rem] [&>p]:leading-[1.75] [&>p]:text-text-muted [&>p]:m-0 [&>p]:mb-4 max-[600px]:[&>p]:text-[0.9rem] max-[600px]:[&>p]:leading-[1.65] [&_strong]:text-body-text">
      {% if profile.bio is string %}
        <p>{{ profile.bio | safe }}</p>
      {% else %}
        {% for paragraph in profile.bio %}
        <p>{{ paragraph | safe }}</p>
        {% endfor %}
      {% endif %}
    </div>
    {% endif %}

    {% if profile.meta %}
    <dl class="resume-quick-meta bg-surface dither-surface border border-border p-3.5 m-0 mt-4 grid grid-cols-[120px_1fr] gap-y-2 gap-x-4 text-[0.8rem] font-code max-[600px]:grid-cols-1 max-[600px]:gap-y-1 print:hidden">
      {% for item in profile.meta %}
      <dt class="meta-label font-code text-text-subtle uppercase tracking-[0.06em] text-[0.7rem] self-center max-[600px]:mt-1.5 first:mt-0">{{ item.label }}</dt>
      <dd class="meta-value font-code m-0 font-bold {% if item.accent %}text-accent{% else %}text-body-text{% endif %}">{{ item.value | safe }}</dd>
      {% endfor %}
    </dl>
    {% endif %}
  </div>
</header>
<div class="dither-rule mb-10 max-md:mb-8 print:hidden" aria-hidden="true"></div>

{% macro project_card(project, ctaText="Read notes") %}
  {% set skillSlugs = [] %}
  {% if project.data.skills %}
    {% for s in project.data.skills %}
      {% set skillSlugs = (skillSlugs.push(s | skillSlug), skillSlugs) %}
    {% endfor %}
  {% endif %}
  <article
    class="project-card border-b border-border py-5 px-3 -mx-3 transition-colors duration-150 ease-default hover:bg-surface/70 max-[480px]:px-2 max-[480px]:-mx-2"
    {% if skillSlugs.length > 0 %}data-skills="{{ skillSlugs.join(',') }}"{% endif %}>
    <div class="flex items-baseline justify-between gap-4 flex-wrap mb-1.5">
      <div class="flex items-baseline gap-2.5 min-w-0">
        <span class="font-code text-[0.85rem] text-accent select-none" aria-hidden="true">&gt;</span>
        <h2 class="project-card__title m-0 font-heading text-[1.15rem] font-bold tracking-[-0.015em] leading-[1.3] [&>a]:text-body-text [&>a]:no-underline [&>a]:transition-colors [&>a]:duration-150 hover:[&>a]:text-accent">
          <a href="{{ project.url }}">{{ project.data.title }}</a>
        </h2>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        {% if project.data.category %}
          <span class="project-card__tag font-code text-[0.7rem] uppercase tracking-[0.06em] text-text-muted">{{ project.data.category | safe }}</span>
        {% endif %}
        <span class="project-card__status font-code text-[0.72rem] text-text-subtle">
          {{ project.date | formatDate if project.date else 'recent' }}
        </span>
      </div>
    </div>
    <p class="project-card__desc font-regular text-[0.86rem] leading-[1.6] text-text-muted m-0 mb-3 pl-5">
      {{ project.data.description }}
    </p>
    {% if project.data.skills and project.data.skills.length > 0 %}
      <div class="pl-5 mb-3 flex flex-wrap gap-x-3 gap-y-1">
        {% for s in project.data.skills %}
          <a
            href="/projects/?skill={{ s | skillSlug }}"
            class="font-code text-[0.73rem] text-text-subtle no-underline hover:text-accent transition-colors duration-150">
            <span class="text-accent/70">#</span>{{ s | skillLabel }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
    <div class="project-card__footer pl-5 flex items-center flex-wrap gap-5">
      <a href="{{ project.url }}" class="project-card__action inline-flex items-center gap-1.5 font-code text-[0.78rem] text-accent no-underline hover:underline underline-offset-4">
        <span>{{ ctaText }}</span>
        <span aria-hidden="true">→</span>
      </a>
      {% if project.data.repo %}
        <a href="{{ project.data.repo }}" class="project-card__action inline-flex items-center gap-1.5 font-code text-[0.78rem] text-accent-2 no-underline hover:underline underline-offset-4" target="_blank" rel="noopener noreferrer">
          <span>github</span>
          <span aria-hidden="true">↗</span>
        </a>
      {% endif %}
    </div>
  </article>
{% endmacro %}
<!-- ── HIGHLIGHTED PROJECTS / EXPERIENCE ─────────────────────────────── -->
<section class="resume-section resume-section--experience mb-12 max-md:mb-9 print:mb-[7pt] print:break-inside-avoid">
  <div class="section-title-wrap flex items-center gap-5 mb-5 max-md:mb-4 print:mb-[3.5pt] print:border-b print:border-[#222222] print:pb-[1pt] print:block">
    <h2 class="section-heading font-heading text-[1.25rem] font-bold tracking-[-0.015em] text-body-text m-0 whitespace-nowrap max-md:text-[1.15rem] print:text-[9.5pt] print:uppercase print:tracking-[0.08em] print:text-[#000000] print:m-0 print:p-0">
      <span class="print-only hidden print:inline">Experience</span><span class="screen-only inline print:hidden">Key Technical Projects</span>
    </h2>
    <span class="section-rule dither-rule grow print:hidden" aria-hidden="true"></span>
  </div>

  <div class="resume-projects-list flex flex-col border-t border-border print:border-none print:gap-[5pt]">
    {% for proj in projects %}
    <div class="resume-project-item border-b border-border py-5 px-3 -mx-3 transition-colors duration-150 ease-default hover:bg-surface/70 max-[600px]:px-2 max-[600px]:-mx-2 print:bg-transparent print:border-none print:p-0 print:mx-0 print:break-inside-avoid">
      <div class="project-item-top flex justify-between items-baseline flex-wrap gap-2 mb-2 print:mb-[1pt]">
        <h3 class="project-item-name m-0 font-heading text-[1.12rem] font-bold max-[600px]:text-[1.02rem] print:text-[10pt] print:m-0 [&>a]:text-body-text [&>a]:no-underline [&>a]:transition-colors [&>a]:duration-150 [&>a]:ease-default hover:[&>a]:text-accent print:[&>a]:text-[#000000]">
          <span class="font-code text-accent mr-1.5 print:hidden" aria-hidden="true">&gt;</span>{% if proj.url %}<a href="{{ proj.url }}">{{ proj.title | safe }}</a>{% else %}{{ proj.title | safe }}{% endif %}
        </h3>
        <span class="project-item-date font-code text-[0.74rem] text-text-subtle print:text-[8pt] print:text-[#444444]">{{ proj.date | safe }}</span>
      </div>
      {% set resolvedTags = proj.tags %}
      {% for colProj in collections.project %}
        {% if colProj.url == proj.url and colProj.data.skills %}
          {% set resolvedTags = colProj.data.skills %}
        {% endif %}
      {% endfor %}
      {% if resolvedTags %}
      <div class="project-item-tags flex flex-wrap gap-x-3 gap-y-1 mb-3 pl-5 print:pl-0 print:mb-[3pt]">
        {% for tag in resolvedTags %}
          {% set tSlug = tag | skillSlug %}
          {% set tLabel = tag | skillLabel %}
          {% if skillPool.bySlug[tSlug] %}
            <a href="/projects/?skill={{ tSlug }}" class="stack-pill font-code text-[0.72rem] text-text-muted no-underline hover:text-accent transition-colors duration-150 print:bg-transparent print:border-none print:p-0 print:text-[8pt] print:text-[#333333] print:inline print:m-0 print:after:content-[',_'] last:print:after:content-none print:after:text-[#555555]"><span class="text-accent/70 print:hidden">#</span>{{ tLabel }}</a>
          {% else %}
            <span class="stack-pill font-code text-[0.72rem] text-text-muted print:bg-transparent print:border-none print:p-0 print:text-[8pt] print:text-[#333333] print:inline print:m-0 print:after:content-[',_'] last:print:after:content-none print:after:text-[#555555]"><span class="text-accent/70 print:hidden">#</span>{{ tLabel }}</span>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
      {% if proj.bullets %}
      <ul class="project-bullet-list list-square pl-9 m-0 [&>li]:font-regular [&>li]:text-[0.85rem] [&>li]:leading-[1.65] [&>li]:text-text-muted [&>li]:mb-[0.35rem] max-[600px]:[&>li]:text-[0.8rem] print:list-disc print:pl-[12pt] print:m-0 print:[&>li]:text-[8.5pt] print:[&>li]:leading-[1.3] print:[&>li]:text-[#222222] print:[&>li]:mb-[2.5pt]">
        {% for bullet in proj.bullets %}
        <li>{{ bullet | safe }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</section>

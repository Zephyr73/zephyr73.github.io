<!-- ── HIGHLIGHTED PROJECTS / EXPERIENCE ─────────────────────────────── -->
<section class="resume-section resume-section--experience mb-14 max-md:mb-11 print:mb-[7pt] print:break-inside-avoid">
  <div class="section-title-wrap flex items-center gap-5 mb-7 max-md:mb-5 print:mb-[3.5pt] print:border-b print:border-[#222222] print:pb-[1pt] print:block">
    <h2 class="section-heading font-heading text-[1.35rem] font-bold tracking-[-0.02em] text-body-text m-0 whitespace-nowrap max-md:text-[1.2rem] print:text-[9.5pt] print:uppercase print:tracking-[0.08em] print:text-[#000000] print:m-0 print:p-0">
      <span class="print-only hidden print:inline">Experience</span><span class="screen-only inline print:hidden">Key Technical Projects</span>
    </h2>
    <span class="section-rule h-[1px] bg-border grow print:hidden"></span>
  </div>

  <div class="resume-projects-list flex flex-col gap-6 print:gap-[5pt]">
    {% for proj in projects %}
    <div class="resume-project-item bg-surface border border-border p-5 transition-[border-color] duration-150 ease-default hover:border-accent max-[600px]:py-4 max-[600px]:px-[14px] print:bg-transparent print:border-none print:p-0 print:break-inside-avoid">
      <div class="project-item-top flex justify-between items-center flex-wrap gap-2 mb-[0.6rem] print:items-baseline print:mb-[1pt]">
        <h3 class="project-item-name m-0 font-heading text-[1.15rem] font-bold max-[600px]:text-[1.05rem] print:text-[10pt] print:m-0 [&>a]:text-body-text [&>a]:no-underline [&>a]:transition-colors [&>a]:duration-150 [&>a]:ease-default hover:[&>a]:text-accent print:[&>a]:text-[#000000]">
          {% if proj.url %}
          <a href="{{ proj.url }}">{{ proj.title | safe }}</a>
          {% else %}
          {{ proj.title | safe }}
          {% endif %}
        </h3>
        <span class="project-item-date font-regular text-[0.75rem] text-text-muted print:text-[8pt] print:text-[#444444]">{{ proj.date | safe }}</span>
      </div>
      {% if proj.tags %}
      <div class="project-item-tags flex flex-wrap gap-[6px] mb-[0.85rem] print:mb-[3pt] [&>span]:font-regular [&>span]:text-[0.7rem] [&>span]:py-[3px] [&>span]:px-2 [&>span]:bg-surface-2 [&>span]:border [&>span]:border-border [&>span]:text-text-muted print:[&>span]:bg-transparent print:[&>span]:border-none print:[&>span]:p-0 print:[&>span]:text-[8pt] print:[&>span]:text-[#333333] print:[&>span]:inline print:[&>span]:m-0 print:[&>span]:after:content-[',_'] last:print:[&>span]:after:content-none print:[&>span]:after:text-[#555555]">
        {% for tag in proj.tags %}
        <span class="stack-pill">{{ tag | safe }}</span>
        {% endfor %}
      </div>
      {% endif %}
      {% if proj.bullets %}
      <ul class="project-bullet-list list-square pl-5 m-0 [&>li]:font-regular [&>li]:text-[0.85rem] [&>li]:leading-[1.65] [&>li]:text-text-muted [&>li]:mb-[0.35rem] max-[600px]:[&>li]:text-[0.8rem] print:list-disc print:pl-[12pt] print:m-0 print:[&>li]:text-[8.5pt] print:[&>li]:leading-[1.3] print:[&>li]:text-[#222222] print:[&>li]:mb-[2.5pt]">
        {% for bullet in proj.bullets %}
        <li>{{ bullet | safe }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</section>

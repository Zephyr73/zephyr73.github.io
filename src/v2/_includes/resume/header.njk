<!-- ── RESUME HEADER ─────────────────────────────────────────────────── -->
<header class="resume-header">
  <div class="resume-sidebar">
    <div class="avatar-frame">
      <img class="resume-avatar" src="{{ profile.avatar | default('/assets/img/profile.png') }}" alt="{{ profile.name | default('Zephyr') }} avatar" />
      <span class="avatar-badge">{{ profile.badge | default('NYC • DEVELOPER') | safe }}</span>
    </div>

    <div class="resume-links">
      {% if profile.email %}
      <button
        class="resume-btn resume-contact__copy"
        data-copy="{{ profile.email }}"
        type="button"
        aria-label="Copy email {{ profile.email }}"
        title="Copy email: {{ profile.email }}"
      >
        <svg
          class="mail-icon"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="16" />
          <path d="M22 6L12 13L2 6" />
        </svg>
        <span class="btn-text">{{ profile.email }}</span>
        <svg
          class="copy-icon"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
        </svg>
      </button>
      {% endif %}

      {% for link in profile.socials %}
      <a
        href="{{ link.url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="resume-btn"
      >
        {% if link.icon == 'github' %}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
        >
          <path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
          />
        </svg>
        {% elif link.icon == 'twitter' %}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
        >
          <path
            d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"
          />
        </svg>
        {% elif link.icon == 'pixiv' %}
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
        >
          <polygon points="12 2 2 7 12 12 22 7 12 2" />
          <polyline points="2 17 12 22 22 17" />
          <polyline points="2 12 12 17 22 12" />
        </svg>
        {% endif %}
        {{ link.label }}
      </a>
      {% endfor %}

      <button onclick="window.print()" class="resume-btn resume-btn--print" type="button">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
        >
          <polyline points="6 9 6 2 18 2 18 9" />
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
          <rect x="6" y="14" width="12" height="8" />
        </svg>
        Print / PDF
      </button>
    </div>
  </div>

  <div class="resume-intro">
    <div class="resume-headline">
      <span class="resume-eyebrow">{{ profile.eyebrow | default('// RESUME & DOSSIER') | safe }}</span>
      <h1 class="resume-name">{{ profile.name | default('Zephyr') }}</h1>
      <div class="resume-role-tag">{{ profile.role | default('Software Developer • Computer Science') | safe }}</div>
      <div class="resume-contact-print">
        <span>{{ profile.location | default('New York, NY') }}</span> •
        <span><a href="mailto:{{ profile.email }}">{{ profile.email }}</a></span> •
        {% for link in profile.socials %}
          {% if link.icon == 'github' %}
          <span><a href="{{ link.url }}">{{ link.url | replace('https://', '') }}</a></span> •
          {% endif %}
        {% endfor %}
        <span><a href="https://zephyr73.github.io">zephyr73.github.io</a></span>
      </div>
    </div>

    {% if profile.summary %}
    <p class="resume-summary-print">
      {{ profile.summary | safe }}
    </p>
    {% endif %}

    {% if profile.bio %}
    <div class="resume-bio">
      {% if profile.bio is string %}
        <p>{{ profile.bio | safe }}</p>
      {% else %}
        {% for paragraph in profile.bio %}
        <p>{{ paragraph | safe }}</p>
        {% endfor %}
      {% endif %}
    </div>
    {% endif %}

    {% if profile.meta %}
    <div class="resume-quick-meta">
      {% for item in profile.meta %}
      <div class="meta-cell">
        <span class="meta-label">{{ item.label }}</span>
        <span class="meta-value{% if item.accent %} text-accent{% endif %}">{{ item.value | safe }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</header>

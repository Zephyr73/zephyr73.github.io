<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="/assets/fonts/JetBrainsMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/JetBrainsMono-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {% if description %}<meta name="description" content="{{ description }}" />{% endif %}

    <title>{{ title | default("Zephyr — Software Developer & Portfolio") }}</title>

    <!-- Prevent scroll jitter on reload & restore saved theme before CSS loads to prevent FOUC -->
    <script>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      (function () {
        var isEmbedded = window.self !== window.top;
        var validV2Accents = ['lavender', 'white', 'catppuccin', 'red', 'coral', 'emerald'];
        var mode;
        var accent;

        if (isEmbedded) {
          mode = sessionStorage.getItem('v2-embedded-mode') || 'dark';
          accent =
            sessionStorage.getItem('v2-embedded-accent') ||
            localStorage.getItem('v3-theme') ||
            'green';
        } else {
          mode = localStorage.getItem('v2-mode') || 'dark';
          var saved = localStorage.getItem('v2-accent');
          accent = saved && validV2Accents.indexOf(saved) !== -1 ? saved : 'lavender';
        }

        var classes = [];
        if (mode === 'light') {
          classes.push('light');
        }
        if (accent) {
          classes.push(accent);
        }
        if (isEmbedded) {
          classes.push('is-embedded');
        }
        
        // Stateful Navbar Transition Logic
        var isGallery = window.location.pathname.indexOf('/gallery') !== -1;
        var wasGallery = sessionStorage.getItem('v2-was-gallery') === 'true';
        sessionStorage.setItem('v2-was-gallery', isGallery);
        
        if (isGallery && !wasGallery) {
          classes.push('nav-starting-narrow');
        } else if (!isGallery && wasGallery) {
          classes.push('nav-starting-wide');
        }
        
        document.documentElement.className = classes.join(' ');
      })();
    </script>

    <!-- Speculative Prerendering: Chromium instantly activates pre-rendered pages -->
    <script type="speculationrules">
      {
        "prerender": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/v3/*" } },
                { "not": { "href_matches": "/*#*" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>

    <!-- Gallery image preload manifest (build-time, consumed by script.js) -->
    <script>
      window.__GALLERY_PRELOAD__ = {{ galleryPreload | dump | safe }};
    </script>

    <link href="/assets/css/style.css" rel="stylesheet" type="text/css" />
  </head>

  <!-- DYNAMIC BODY CLASSES: Allows you to style specific pages differently -->
  <body class="page {{ bodyClass }}" data-page="{{ pageId }}">

    <!-- MOBILE DRAWER -->
    {% include "drawer.njk" %}

    <!-- MAIN NAVIGATION -->
    {% include "navbar.njk" %}

    <!-- CONTENT INJECTION POINT -->
    <main class="page__content">
      {% if noMarkdownWrapper %}
        {{ content | safe }}
      {% else %}
        <!-- This wrapper ensures markdown styles apply to blog/project content with wide-screen TOC -->
        <div class="markdown-layout">
          <aside class="markdown-toc" aria-label="Table of contents">
            <div class="markdown-toc__inner">
              <div class="markdown-toc__header">
                <span class="toc-header__prefix">//</span> ON THIS PAGE
              </div>
              <nav class="markdown-toc__nav">
                <ul class="markdown-toc__list"></ul>
              </nav>
            </div>
          </aside>
          <div class="markdown-content prose max-w-none">
            {{ content | safe }}
          </div>
        </div>
      {% endif %}
    </main>

    <!-- FOOTER -->
    {% include "footer.njk" %}

    <script src="/assets/js/script.js"></script>
    <script>
      // Trigger the navbar width animation instantly after first paint
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          document.documentElement.classList.remove('nav-starting-narrow', 'nav-starting-wide');
        });
      });
    </script>
  </body>
</html>
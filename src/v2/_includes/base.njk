<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="/assets/fonts/JetBrainsMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/JetBrainsMono-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {% if description %}<meta name="description" content="{{ description }}" />{% endif %}

    <title>{{ title | default("Zephyr — Software Developer & Portfolio") }}</title>

    <!-- Restore saved theme & mode before CSS loads to prevent FOUC -->
    <script>
      (function () {
        var isEmbedded = window.self !== window.top;
        var mode = localStorage.getItem('v2-mode');
        var theme = localStorage.getItem('v2-theme') || localStorage.getItem('theme');
        if (!mode) {
          mode = theme === 'light' ? 'light' : 'dark';
        }
        var accent = localStorage.getItem('v2-accent') || theme || 'lavender';
        if (accent === 'light' || accent === 'dark') {
          accent = 'lavender';
        }
        if (isEmbedded || theme === 'system') {
          accent = localStorage.getItem('v3-theme') || 'green';
        }
        var classes = [];
        if (mode === 'light') {
          classes.push('light');
        }
        if (accent) {
          classes.push(accent);
        }
        document.documentElement.className = classes.join(' ');
      })();
    </script>

    <link href="/assets/css/style.css" rel="stylesheet" type="text/css" />
  </head>

  <!-- DYNAMIC BODY CLASSES: Allows you to style specific pages differently -->
  <body class="page {{ bodyClass }}" data-page="{{ pageId }}">

    <!-- MOBILE DRAWER -->
    {% include "drawer.njk" %}

    <!-- MAIN NAVIGATION -->
    {% include "navbar.njk" %}

    <!-- CONTENT INJECTION POINT -->
    <main class="page__content">
      {% if noMarkdownWrapper %}
        {{ content | safe }}
      {% else %}
        <!-- This wrapper ensures markdown styles apply to blog/project content with wide-screen TOC -->
        <div class="markdown-layout">
          <aside class="markdown-toc" aria-label="Table of contents">
            <div class="markdown-toc__inner">
              <div class="markdown-toc__header">
                <span class="toc-header__prefix">//</span> ON THIS PAGE
              </div>
              <nav class="markdown-toc__nav">
                <ul class="markdown-toc__list"></ul>
              </nav>
            </div>
          </aside>
          <div class="markdown-content">
            {{ content | safe }}
          </div>
        </div>
      {% endif %}
    </main>

    <!-- FOOTER -->
    {% include "footer.njk" %}

    <script src="/assets/js/script.js"></script>
  </body>
</html>
---
pagination:
  data: galleryImages
  size: 1
  alias: img
permalink: "/gallery/image/{{ img.slug }}/"
layout: base.njk
bodyClass: page--gallery-detail
pageId: gallery
eleventyComputed:
  title: "{{ img.category | capitalize }} — {{ img.filename }}"
  description: "Details for {{ img.filename }} from the {{ img.category }} gallery."
noMarkdownWrapper: true
---

<div class="gallery-detail flex flex-col gap-[20px] mt-[20px] mb-[40px] w-full [@media(min-width:769px)_and_(min-height:650px)]:flex-1 [@media(min-width:769px)_and_(min-height:650px)]:min-h-0">

  <a href="/gallery/#{{ 'ai-container' if img.category == 'ai' else img.category }}" class="gallery-detail__back font-regular text-[13px] text-body-text no-underline opacity-60 transition-opacity duration-200 ease self-start hover:opacity-100">← Back to Gallery</a>

  <div class="gallery-detail__layout flex flex-col gap-[30px] w-full [@media(min-width:769px)_and_(min-height:650px)]:flex-1 [@media(min-width:769px)_and_(min-height:650px)]:min-h-0 [@media(min-width:769px)_and_(min-height:650px)]:flex-row [@media(min-width:769px)_and_(min-height:650px)]:gap-[40px] [@media(min-width:769px)_and_(min-height:650px)]:items-stretch [@media(min-width:769px)_and_(min-height:650px)]:overflow-hidden">

    <div class="gallery-detail__image-wrap w-full flex items-center justify-center [@media(min-width:769px)_and_(min-height:650px)]:flex-1 [@media(min-width:769px)_and_(min-height:650px)]:h-full [@media(min-width:769px)_and_(min-height:650px)]:min-w-0 [&>picture]:flex [&>picture]:items-center [&>picture]:justify-center [&>picture]:w-full [&>picture]:h-full [&>picture]:max-w-full [&_img]:block [&_img]:max-w-full [&_img]:h-auto [&_img]:max-h-[60vh] [&_img]:object-contain [&_img]:shadow-[0_12px_40px_rgba(0,0,0,0.4)] [&_img]:border [&_img]:border-[rgba(255,255,255,0.08)] [@media(min-width:769px)_and_(min-height:650px)]:[&_img]:max-h-full">
      <picture>
        <source srcset="{{ img.webpUrl }}" type="image/webp" />
        <img
          src="{{ img.fullUrl }}"
          alt="{{ img.filename }}"
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>

    <div class="gallery-detail__panel w-full bg-container-bg border border-[rgba(255,255,255,0.08)] p-[28px] flex flex-col gap-[24px] box-border [@media(min-width:769px)_and_(min-height:650px)]:flex-none [@media(min-width:769px)_and_(min-height:650px)]:w-[380px] [@media(min-width:769px)_and_(min-height:650px)]:h-full [@media(min-width:769px)_and_(min-height:650px)]:overflow-y-auto [@media(min-width:769px)_and_(min-height:650px)]:scrollbar-thin [@media(min-width:769px)_and_(min-height:650px)]:[scrollbar-color:var(--color-body-text)_transparent]">

      <h1 class="gallery-detail__title font-bold text-[16px] text-body-text m-0 leading-[1.4] opacity-90">{{ img.category | capitalize }} — {{ img.filename }}</h1>

      <table class="gallery-detail__table w-full border-collapse font-regular text-[13px] [&_tr]:border-b [&_tr]:border-[rgba(255,255,255,0.06)] [&_tr:first-child]:border-t [&_tr:first-child]:border-[rgba(255,255,255,0.06)] [&_td]:py-[12px] [&_td]:px-[8px] [&_td]:text-body-text [&_td]:align-middle [&_td:first-child]:w-[40%] [&_td:first-child]:opacity-50 [&_td:first-child]:font-bold [&_td:last-child]:text-right">
        {% if img.device %}
        <tr>
          <td>Device</td>
          <td>{{ img.device }}</td>
        </tr>
        {% endif %}
        {% if img.lens %}
        <tr>
          <td>Lens</td>
          <td>{{ img.lens }}</td>
        </tr>
        {% endif %}
        {% if img.date %}
        <tr>
          <td>Date taken</td>
          <td>{{ img.date }}</td>
        </tr>
        {% endif %}
        <tr>
          <td>Resolution</td>
          <td>{{ img.resolution }}</td>
        </tr>
        <tr>
          <td>File size</td>
          <td>{{ img.fileSize }}</td>
        </tr>
        {% if img.shutterSpeed %}
        <tr>
          <td>Shutter speed</td>
          <td>{{ img.shutterSpeed }}</td>
        </tr>
        {% endif %}
        {% if img.aperture %}
        <tr>
          <td>Aperture</td>
          <td>{{ img.aperture }}</td>
        </tr>
        {% endif %}
        {% if img.iso %}
        <tr>
          <td>ISO</td>
          <td>{{ img.iso }}</td>
        </tr>
        {% endif %}
        {% if img.focalLength %}
        <tr>
          <td>Focal length</td>
          <td>{{ img.focalLength }}</td>
        </tr>
        {% endif %}
        <tr>
          <td>License</td>
          <td>© Tasrif · <a href="/LICENSE-CONTENT" class="underline underline-offset-[2px]">CC BY-NC 4.0</a></td>
        </tr>
      </table>

      <a href="{{ img.fullUrl }}" download="{{ img.downloadFilename }}" class="gallery-detail__download block w-full text-center box-border bg-body-text text-body-bg font-bold text-[13px] py-[12px] px-[20px] no-underline border border-body-text transition-all duration-200 ease cursor-pointer hover:bg-transparent hover:text-body-text [@media(min-width:769px)_and_(min-height:650px)]:w-auto [@media(min-width:769px)_and_(min-height:650px)]:self-start">
        Download full resolution
      </a>

    </div>
  </div>
</div>

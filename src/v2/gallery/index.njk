---
layout: base.njk
permalink: /gallery/
title: Gallery
bodyClass: page--gallery
pageId: gallery
noMarkdownWrapper: true
description: 'Explore my collection of photography, AI-generated art, and Forza screenshots.'
---

<nav class="gallery-tabs" aria-label="Gallery sections">
  <ul>
    <li><button type="button" class="gallery-tabs__btn">Photography</button></li>
    <li><button type="button" class="gallery-tabs__btn">AI-Generations</button></li>
    <li><button type="button" class="gallery-tabs__btn">Forza</button></li>
  </ul>
</nav>
<div class="gallery-grid gallery-grid--photography">
  {% for col in [0, 1, 2] %}
    <div class="gallery-grid__column">
      {% for img in gallery.photography %}
        {% if (loop.index0 % 3) == col %}
          {% if loop.index0 == 0 %}
            {% gimg img.src, img.alt, "eager", "high", loop.index0 %}
          {% else %}
            {% gimg img.src, img.alt, "", "", loop.index0 %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  {% endfor %}
</div>
<div class="gallery-grid gallery-grid--ai">
  {% for col in [0, 1, 2] %}
    <div class="gallery-grid__column">
      {% for img in gallery.ai %}
        {% if (loop.index0 % 3) == col %}
          {% gimg img.src, img.alt, "", "", loop.index0 %}
        {% endif %}
      {% endfor %}
    </div>
  {% endfor %}
</div>
<div class="gallery-grid gallery-grid--forza">
  {% for col in [0, 1, 2] %}
    <div class="gallery-grid__column">
      {% for img in gallery.forza %}
        {% if (loop.index0 % 3) == col %}
          {% gimg img.src, img.alt, "", "", loop.index0 %}
        {% endif %}
      {% endfor %}
    </div>
  {% endfor %}
</div>

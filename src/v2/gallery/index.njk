    <li class="m-0 p-0 list-none max-md:flex-1 max-md:min-w-0 max-md:flex"><button type="button" class="gallery-tabs__btn bg-transparent border border-transparent text-text-muted font-regular text-[0.825rem] font-semibold py-[7px] px-4 cursor-pointer rounded-none tracking-[0.02em] transition-all duration-150 ease-default whitespace-nowrap box-border hover:text-body-text [&.is-active]:bg-surface-2 [&.is-active]:border-border [&.is-active]:text-accent max-md:w-full max-md:min-w-0 max-md:flex max-md:items-center max-md:justify-center max-md:py-[6px] max-md:px-[2px] max-md:text-[clamp(0.68rem,2.7vw,0.775rem)] max-md:tracking-normal max-md:overflow-hidden max-md:text-ellipsis max-md:leading-[1.2]">Forza</button></li>

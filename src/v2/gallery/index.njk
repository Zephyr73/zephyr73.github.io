<div id="photography" class="gallery-grid gallery-grid--photography hidden opacity-0 transition-opacity duration-150 ease-default flex-row justify-between items-start pt-[20px] gap-[20px] [&.is-visible]:flex [&.is-visible]:opacity-1 max-md:gap-[20px] max-md:flex-col max-[519px]:max-md:flex min-[520px]:max-md:[&.is-visible]:grid min-[520px]:max-md:grid-cols-2 min-[520px]:max-md:gap-4">
  {% for col in [0, 1, 2] %}
    <div class="gallery-grid__column flex flex-col w-[32.5%] items-center gap-[20px] contain-layout max-md:contents [&_picture]:block [&_picture]:w-full [&_img]:block [&_img]:w-full [&_img]:object-cover [&_img]:translate-z-0 [&_img]:backface-hidden">
      {% for img in gallery.photography %}
        {% if (loop.index0 % 3) == col %}
          {% if loop.index0 < 3 %}
            {% gimg img.src, img.alt, "eager", "high", loop.index0 %}
          {% else %}
            {% gimg img.src, img.alt, "", "", loop.index0 %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  {% endfor %}
</div>
<div id="ai-container" class="gallery-grid gallery-grid--ai hidden opacity-0 transition-opacity duration-150 ease-default flex-row justify-between items-start pt-[20px] gap-[20px] [&.is-visible]:flex [&.is-visible]:opacity-1 max-md:gap-[20px] max-md:flex-col max-[519px]:max-md:flex min-[520px]:max-md:[&.is-visible]:grid min-[520px]:max-md:grid-cols-2 min-[520px]:max-md:gap-4">
  {% for col in [0, 1, 2] %}
    <div class="gallery-grid__column flex flex-col w-[32.5%] items-center gap-[20px] contain-layout max-md:contents [&_picture]:block [&_picture]:w-full [&_img]:block [&_img]:w-full [&_img]:object-cover [&_img]:translate-z-0 [&_img]:backface-hidden">
      {% for img in gallery.ai %}
        {% if (loop.index0 % 3) == col %}
          {% gimg img.src, img.alt, "", "", loop.index0 %}
        {% endif %}
      {% endfor %}
    </div>
  {% endfor %}
</div>
<div id="forza" class="gallery-grid gallery-grid--forza hidden opacity-0 transition-opacity duration-150 ease-default flex-row justify-between items-start pt-[20px] gap-[20px] [&.is-visible]:flex [&.is-visible]:opacity-1 max-md:gap-[20px] max-md:flex-col max-[519px]:max-md:flex min-[520px]:max-md:[&.is-visible]:grid min-[520px]:max-md:grid-cols-2 min-[520px]:max-md:gap-4">
  {% for col in [0, 1, 2] %}

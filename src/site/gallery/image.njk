---
pagination:
  data: galleryImages
  size: 1
  alias: img
permalink: "/gallery/image/{{ img.slug }}/"
layout: base.njk
bodyClass: page--gallery-detail
pageId: gallery
eleventyComputed:
  title: "{{ img.category | capitalize }} — {{ img.filename }}"
  description: "Details for {{ img.filename }} from the {{ img.category }} gallery."
noMarkdownWrapper: true
---

<div class="gallery-detail flex flex-col gap-5 mt-3 mb-10 w-full [@media(min-width:1024px)_and_(min-height:650px)]:mb-2">

  <a href="/gallery/#{{ 'ai-container' if img.category == 'ai' else img.category }}" class="gallery-detail__back font-code text-[0.8rem] text-text-muted no-underline transition-colors duration-150 ease self-start hover:text-accent">← back to gallery</a>

  <div class="gallery-detail__layout flex flex-col gap-6 w-full [@media(min-width:1024px)_and_(min-height:650px)]:flex-row [@media(min-width:1024px)_and_(min-height:650px)]:gap-8 [@media(min-width:1024px)_and_(min-height:650px)]:items-start">

    <div class="gallery-detail__image-wrap w-full flex items-center justify-center [@media(min-width:1024px)_and_(min-height:650px)]:flex-1 [@media(min-width:1024px)_and_(min-height:650px)]:min-w-0 [&>picture]:flex [&>picture]:items-center [&>picture]:justify-center [&>picture]:w-full [&>picture]:max-w-full [&_img]:block [&_img]:max-w-full [&_img]:w-auto [&_img]:h-auto [&_img]:max-h-[68vh] [&_img]:max-h-[68dvh] [&_img]:object-contain [&_img]:border [&_img]:border-border [&_img]:bg-surface [@media(min-width:1024px)_and_(min-height:650px)]:[&_img]:max-h-[calc(100dvh-165px)]">
      <picture>
        <source
          srcset="{{ img.srcsetWebp }}"
          sizes="(max-width: 1023px) calc(100vw - 40px), calc(100vw - 460px)"
          type="image/webp"
        />
        <img
          src="{{ img.webpUrl }}"
          alt="{{ img.filename }}"
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>

    <aside class="gallery-detail__panel w-full bg-surface dither-surface border border-border p-6 flex flex-col gap-5 box-border [@media(min-width:1024px)_and_(min-height:650px)]:flex-none [@media(min-width:1024px)_and_(min-height:650px)]:w-[380px]">

      <h1 class="gallery-detail__title font-heading text-[1.1rem] font-bold text-body-text m-0 leading-[1.35] break-words">
        <span class="font-code text-accent mr-1.5" aria-hidden="true">&gt;</span>{{ img.category | capitalize }} — {{ img.filename }}
      </h1>

      <table class="gallery-detail__table w-full border-collapse font-code text-[0.78rem] m-0 [&_tr]:border-b [&_tr]:border-border/70 [&_tr:first-child]:border-t [&_tr:first-child]:border-border/70 [&_td]:py-2.5 [&_td]:px-1 [&_td]:align-middle [&_td:first-child]:w-[40%] [&_td:first-child]:text-text-subtle [&_td:first-child]:uppercase [&_td:first-child]:tracking-[0.05em] [&_td:first-child]:text-[0.68rem] [&_td:last-child]:text-right [&_td:last-child]:text-body-text">
        {% if img.device %}
        <tr>
          <td>Device</td>
          <td>{{ img.device }}</td>
        </tr>
        {% endif %}
        {% if img.lens %}
        <tr>
          <td>Lens</td>
          <td>{{ img.lens }}</td>
        </tr>
        {% endif %}
        {% if img.date %}
        <tr>
          <td>Date taken</td>
          <td>{{ img.date }}</td>
        </tr>
        {% endif %}
        <tr>
          <td>Resolution</td>
          <td>{{ img.resolution }}</td>
        </tr>
        <tr>
          <td>File size</td>
          <td>{{ img.fileSize }}</td>
        </tr>
        {% if img.shutterSpeed %}
        <tr>
          <td>Shutter speed</td>
          <td>{{ img.shutterSpeed }}</td>
        </tr>
        {% endif %}
        {% if img.aperture %}
        <tr>
          <td>Aperture</td>
          <td>{{ img.aperture }}</td>
        </tr>
        {% endif %}
        {% if img.iso %}
        <tr>
          <td>ISO</td>
          <td>{{ img.iso }}</td>
        </tr>
        {% endif %}
        {% if img.focalLength %}
        <tr>
          <td>Focal length</td>
          <td>{{ img.focalLength }}</td>
        </tr>
        {% endif %}
        <tr>
          <td>License</td>
          <td>© Tasrif · <a href="/LICENSE-CONTENT" class="text-accent-2 underline underline-offset-[2px] hover:text-accent">CC BY-NC 4.0</a></td>
        </tr>
      </table>

      <a href="{{ img.fullUrl }}" download="{{ img.downloadFilename }}" class="gallery-detail__download inline-flex items-center justify-center gap-2 w-full text-center box-border bg-accent text-accent-text font-code font-bold text-[0.8rem] py-2.5 px-4 no-underline border border-accent transition-colors duration-150 ease cursor-pointer hover:bg-accent-dim hover:border-accent-dim min-h-[42px] mt-auto">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Download Full Resolution
      </a>

    </aside>
  </div>
</div>

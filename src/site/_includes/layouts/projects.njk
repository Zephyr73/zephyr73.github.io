---
layout: base.njk
noMarkdownWrapper: true
---
{% from "components/card.njk" import project_card %}

<div class="projects-page">
  <div class="page-intro pb-2 max-md:pb-1">
    <h1 class="page-intro__title font-heading text-[clamp(1.65rem,3.4vw,2.2rem)] font-bold tracking-[-0.02em] leading-[1.2] text-body-text m-0 mb-2.5">{{ heading | safe }}</h1>
    <p class="page-intro__desc font-sans text-[1rem] leading-[1.65] text-text-muted max-w-[62ch] m-0">
      {{ intro | safe }}
    </p>
  </div>

  <div class="dither-rule my-6 max-md:my-5" aria-hidden="true"></div>

  <!-- Global Skill Pool Filter -->
  <div class="mb-6" id="project-skill-filter" aria-label="Filter projects by skill">
    <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2.5 font-code text-[0.74rem]">
      <span class="text-text-subtle uppercase tracking-[0.06em]">skill pool ({{ skillPool.withProjects.length }})</span>
      <span id="skill-filter-status" class="text-text-muted">showing {{ collections.project.length }} of {{ collections.project.length }}</span>
    </div>
    <div class="flex flex-wrap gap-1.5 max-md:gap-2">
      <button
        type="button"
        data-skill-filter="all"
        aria-pressed="true"
        class="skill-filter-btn font-code text-[0.75rem] py-1 px-2.5 max-md:py-1.5 max-md:px-3 max-md:min-h-[34px] bg-surface border border-accent text-accent cursor-pointer transition-colors duration-150">
        all ({{ collections.project.length }})
      </button>
      {% for s in skillPool.withProjects %}
        <button
          type="button"
          data-skill-filter="{{ s.slug }}"
          aria-pressed="false"
          class="skill-filter-btn font-code text-[0.75rem] py-1 px-2.5 max-md:py-1.5 max-md:px-3 max-md:min-h-[34px] bg-surface border border-border text-text-muted cursor-pointer transition-colors duration-150 hover:border-accent hover:text-accent">
          #{{ s.name }} <span class="text-text-subtle">({{ s.count }})</span>
        </button>
      {% endfor %}
    </div>
  </div>

  <div class="project-list flex flex-col border-t border-border" id="project-list">
    {% for project in collections.project | sortByDate %}
      {{ project_card(project) }}
    {% endfor %}
  </div>
  <p id="skill-filter-empty" class="hidden font-code text-[0.85rem] text-text-muted py-6 m-0">
    No projects match that skill tag.
  </p>
</div>

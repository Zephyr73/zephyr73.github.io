---
layout: base.njk
noMarkdownWrapper: true
---

{% from "components/card.njk" import project_card %}
<!-- ── WHOAMI / INTRO ────────────────────────────────────────────────────── -->
<section class="home-hero pt-4 pb-2 max-md:pt-1">
    <p class="font-code text-[0.8rem] text-accent m-0 mb-3 tracking-[0.02em]">
        {{ hero.prompt }}
    </p>
    <h1 class="hero-title font-heading text-[clamp(1.65rem,3.4vw,2.25rem)] font-bold leading-[1.2] tracking-[-0.02em]
            text-body-text m-0 mb-4 max-w-[720px]">
        {{ hero.heading }}
    </h1>
    <p class="hero-subtitle font-sans text-[1.03rem] leading-[1.68] text-text-muted max-w-[62ch] m-0 mb-6">
        {{ hero.subtitle | safe }}
    </p>
    <!-- Compact terminal spec block -->
    <dl class="bg-surface dither-surface border border-border p-4 m-0 mb-7 grid grid-cols-[110px_1fr] gap-y-2 gap-x-4
            text-[0.82rem] font-code max-[520px]:grid-cols-1 max-[520px]:gap-y-1">
        <dt class="text-text-subtle uppercase tracking-[0.06em] text-[0.72rem] self-center">focus</dt>
        <dd class="m-0 text-body-text">{{ hero.spec.focus }}</dd>
        <dt class="text-text-subtle uppercase tracking-[0.06em] text-[0.72rem] self-center max-[520px]:mt-2">stack</dt>
        <dd class="m-0 flex flex-wrap gap-x-3 gap-y-1">
            {% for s in skillPool.top %}
                <a
                    href="/projects/?skill={{ s.slug }}"
                    class="text-text-muted no-underline hover:text-accent transition-colors duration-150">
                    <span class="text-accent/70">#</span>
                    {{ s.name }}</a>
            {% endfor %}
        </dd>
        <dt class="text-text-subtle uppercase tracking-[0.06em] text-[0.72rem] self-center max-[520px]:mt-2">status</dt>
        <dd class="m-0 text-accent">{{ hero.spec.status }}</dd>
    </dl>
    <div class="hero-actions flex items-center flex-wrap gap-3 max-[480px]:flex-col max-[480px]:items-stretch">
        {% for action in hero.actions %}
            {% if action.primary %}
                <a href="{{ action.url }}" class="inline-flex items-center justify-center gap-2 font-code text-[0.82rem] font-bold py-2.5 px-4 bg-accent text-accent-text border border-accent no-underline transition-colors duration-150 hover:bg-accent-dim hover:border-accent-dim min-h-[44px] box-border">
                    {{ action.label }}
                </a>
            {% elif action.external %}
                <a href="{{ action.url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 font-code text-[0.82rem] text-text-muted border border-transparent max-[480px]:border-border max-[480px]:bg-surface py-2.5 px-3 no-underline transition-colors duration-150 hover:text-accent hover:border-accent min-h-[44px] box-border">
                    {{ action.label }}
                </a>
            {% else %}
                <a href="{{ action.url }}" class="inline-flex items-center justify-center gap-2 font-code text-[0.82rem] font-semibold py-2.5 px-4 bg-surface text-body-text border border-border no-underline transition-colors duration-150 hover:border-accent hover:text-accent min-h-[44px] box-border">
                    {{ action.label }}
                </a>
            {% endif %}
        {% endfor %}
    </div>
</section>
<div class="dither-rule my-10 max-md:my-8" aria-hidden="true"></div>
<!-- ── SELECTED PROJECTS ─────────────────────────────────────────────────── -->
<section class="home-section">
    <div class="section-header flex justify-between items-baseline mb-4 flex-wrap gap-3">
        <h2 class="section-title font-heading text-[1.25rem] font-bold tracking-[-0.015em] text-body-text m-0">
            Selected Projects
        </h2>
        <a
            href="/projects/"
            class="section-link font-code text-[0.8rem] text-text-muted no-underline transition-colors duration-150
                hover:text-accent">
            all projects →
        </a>
    </div>
    <div class="border-t border-border">
        {% for project in collections.project %}
            {% if project.fileSlug in featuredProjectSlugs %}
                {{ project_card(project) }}
            {% endif %}
        {% endfor %}
    </div>
</section>
<div class="dither-rule my-10 max-md:my-8" aria-hidden="true"></div>
<!-- ── RECENT WRITING ────────────────────────────────────────────────────── -->
<section class="home-section">
    <div class="section-header flex justify-between items-baseline mb-4 flex-wrap gap-3">
        <h2 class="section-title font-heading text-[1.25rem] font-bold tracking-[-0.015em] text-body-text m-0">
            Recent Writing
        </h2>
        <a
            href="/blog/"
            class="section-link font-code text-[0.8rem] text-text-muted no-underline transition-colors duration-150
                hover:text-accent">
            all posts →
        </a>
    </div>
    <ul class="list-none m-0 p-0 border-t border-border">
        {% for post in collections.blogpost | sortByDate %}
            {% if loop.index0 < 3 %}
                <li class="border-b border-border last:border-b-0">
                    <a href="{{ post.url }}" class="flex items-baseline justify-between gap-4 py-3.5 px-3 -mx-3 no-underline transition-colors duration-150 hover:bg-surface/70 max-[520px]:flex-col max-[520px]:gap-1 max-[480px]:px-2 max-[480px]:-mx-2 group">
                        <span class="flex items-baseline gap-2.5 min-w-0 font-sans font-medium text-[0.98rem] text-body-text group-hover:text-accent
                                transition-colors duration-150">
                            <span class="font-code text-accent shrink-0" aria-hidden="true">&gt;</span>
                            <span class="min-w-0">{{ post.data.title }}</span>
                        </span>
                        <span class="font-code tabular-nums text-[0.78rem] text-text-subtle shrink-0 max-[520px]:pl-5">
                            {{ post.date | formatDate if post.date else 'recent' }}
                        </span>
                    </a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
</section>
<div class="dither-rule my-10 max-md:my-8" aria-hidden="true"></div>
<!-- ── VISUAL GALLERY (DITHERED PREVIEW) ─────────────────────────────────── -->
<section class="home-section">
    <div class="section-header flex justify-between items-baseline mb-4 flex-wrap gap-3">
        <h2 class="section-title font-heading text-[1.25rem] font-bold tracking-[-0.015em] text-body-text m-0">
            Photography &amp; Visuals
        </h2>
        <a
            href="/gallery/"
            class="section-link font-code text-[0.8rem] text-text-muted no-underline transition-colors duration-150
                hover:text-accent">
            open gallery →
        </a>
    </div>
    <div class="grid grid-cols-2 gap-4 max-[640px]:grid-cols-1">
        {% for card in galleryPreview %}
            <a href="{{ card.url }}" class="group bg-surface border border-border no-underline flex items-center gap-4 p-3 transition-colors duration-150 hover:border-accent">
                <div class="w-[120px] h-[76px] shrink-0 border border-border overflow-hidden bg-surface-2">
                    {% ditherThumb card.img, card.alt, 120, 76 %}
                </div>
                <div class="min-w-0">
                    <h3 class="m-0 mb-1 font-heading text-[1rem] text-body-text group-hover:text-accent transition-colors duration-150">
                        {{ card.title }}
                    </h3>
                    <p class="m-0 font-sans text-[0.875rem] leading-[1.52] text-text-muted">
                        {{ card.desc }}
                    </p>
                </div>
            </a>
        {% endfor %}
    </div>
</section>
<div class="dither-rule my-10 max-md:my-8" aria-hidden="true"></div>
<!-- ── CONTACT ───────────────────────────────────────────────────────────── -->
<section class="home-contact pb-2">
    <div class="flex items-baseline justify-between flex-wrap gap-4">
        <div>
            <h2 class="font-heading text-[1.1rem] font-bold text-body-text m-0 mb-1">{{ contact.heading }}</h2>
            <p class="font-sans text-[0.92rem] text-text-muted m-0">
                {{ contact.subtitle }}
            </p>
        </div>
        <div class="flex items-center flex-wrap gap-3 max-[480px]:w-full">
            <button class="resume-contact__copy inline-flex items-center justify-center font-code text-[0.8rem] font-semibold py-2 px-3.5 bg-surface text-body-text border border-border cursor-pointer transition-colors duration-150 hover:border-accent hover:text-accent min-h-[44px] max-[480px]:w-full" data-copy="{{ contact.email }}" type="button">
                Copy {{ contact.email }}
            </button>
        </div>
    </div>
</section>
<!-- ── TECHNICAL SKILLS MATRIX ──────────────────────────────────────── -->
<section class="resume-section resume-section--skills mb-12 max-md:mb-9 print:mb-[7pt] print:break-inside-avoid">
    <div class="section-title-wrap flex items-center gap-5 mb-5 max-md:mb-4 print:mb-[3.5pt] print:border-b print:border-[#222222]
            print:pb-[1pt] print:block">
        <h2 class="section-heading font-heading text-[1.25rem] font-bold tracking-[-0.015em] text-body-text m-0 whitespace-nowrap
                max-md:text-[1.15rem] print:text-[9.5pt] print:uppercase print:tracking-[0.08em] print:text-[#000000] print:m-0
                print:p-0">
            <span class="screen-only inline print:hidden">Technical
            </span>Skills</h2>
        <span class="section-rule dither-rule grow print:hidden" aria-hidden="true"></span>
    </div>
    <!-- Screen view: auto-collected project skill pool grouped by domain -->
    <div class="skills-category-group flex flex-col print:hidden">
        {% for cat in skillPool.categories %}
            <div class="skill-category grid grid-cols-[210px_1fr] gap-4 items-baseline py-3.5 border-b border-border last:border-b-0
                    max-[640px]:grid-cols-1 max-[640px]:gap-2">
                <h3 class="skill-cat-title font-code text-[0.76rem] uppercase tracking-[0.06em] text-text-muted m-0">{{ cat.category }}</h3>
                <div class="skills-pill-grid flex flex-wrap gap-x-4 gap-y-1.5">
                    {% for item in cat.items %}
                        {% if item.count > 0 %}
                            <a
                                href="/projects/?skill={{ item.slug }}"
                                class="skill-tag font-sans text-[0.88rem] text-body-text no-underline inline-flex items-center gap-[5px]
                                    hover:text-accent transition-colors duration-150">
                                <span class="tag-accent font-code text-accent font-bold">#</span>
                                {{ item.name }}
                                <span class="font-code tabular-nums text-[0.72rem] text-text-subtle">({{ item.count }})</span>
                            </a>
                        {% else %}
                            <span class="skill-tag font-sans text-[0.88rem] text-body-text inline-flex items-center gap-[5px]">
                                <span class="tag-accent font-code text-accent font-bold">#</span>
                                {{ item.name }}
                            </span>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
    <!-- Print view: structured ATS skills list (from global skillPool) -->
    <div class="skills-category-group hidden print:flex print:flex-col print:gap-[2.5pt]">
        {% for cat in skillPool.categories %}
            <div class="skill-category print:flex print:flex-row print:items-baseline print:gap-[4pt] print:m-0">
                <h3 class="skill-cat-title print:text-[8.5pt] print:font-bold print:text-[#000000] print:min-w-[145pt] print:m-0
                    print:normal-case print:tracking-normal">{{ cat.category }}</h3>
                <div class="skills-pill-grid print:inline print:gap-0">
                    {% for item in cat.items %}
                        <div class="skill-tag print:bg-transparent print:border-none print:p-0 print:text-[8.5pt] print:text-[#222222] print:inline
                            print:m-0 print:after:content-[',_'] last:print:after:content-none print:after:text-[#444444]">{{ item.name }}</div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
</section>